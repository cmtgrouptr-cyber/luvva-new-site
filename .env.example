WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=440660250340036
WHATSAPP_BUSINESS_ACCOUNT_ID=1316656840545060
WHATSAPP_TEMPLATE_NAME=luvva_login_code
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_OTP_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional compatibility names; leave blank when using the names above
